<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xss="clr-namespace:X.SuperResolution"
             x:Class="X.SuperResolution.App"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <xss:ViewLocator />
    </Application.DataTemplates>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="Assets/Languages/zh-CN.axaml" />
                <ResourceInclude Source="Assets/Themes/WorkbenchColors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme DensityStyle="Compact">
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light"
                                       Accent="#367C60"
                                       RegionColor="#F6F7F6"
                                       ErrorText="#A54450" />
                <ColorPaletteResources x:Key="Dark"
                                       Accent="#65B18D"
                                       RegionColor="#202020"
                                       ErrorText="#F0A8AC" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://X.SuperResolution/Assets/Themes/WorkbenchStyles.axaml" />
    </Application.Styles>
</Application>
